<script>

fetch("../data/village.json")

.then(response => response.json())

.then(data => {

document.getElementById("population").innerHTML =
data.population;

document.getElementById("households").innerHTML =
data.households;

document.getElementById("elderly").innerHTML =
data.elderly;

document.getElementById("disabled").innerHTML =
data.disabled;

document.getElementById("vrv").innerHTML =
data.vrv;

})

.catch(error=>{
console.log(error);
});


</script>
